{
  "workshop": {
    "schema": {
      "version": "2024.08.07"
    }
  },
  "userenv": {
    "name": "cuda-12.8",
    "label": "NVIDIA CUDA 12.8.1 on Rocky Linux 9",
    "origin": {
      "image": "docker.io/nvidia/cuda",
      "tag": "12.8.1-devel-rockylinux9",
      "build-policy": "missing",
      "update-policy": "never"
    },
    "properties": {
      "platform": [
        {
          "architecture": "x86_64"
        },
        {
          "architecture": "aarch64"
        }
      ],
      "packages": {
        "type": "rpm",
        "manager": "dnf"
      }
    }
  },
  "requirements": [
    {
      "name": "python3",
      "type": "distro",
      "distro_info": {
        "packages": [
          "python3",
          "python3-pip"
        ]
      }
    }
  ]
}
