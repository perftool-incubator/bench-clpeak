{
  "presets": {
    "defaults": [
      { "arg": "tests", "vals": ["all"] },
      { "arg": "max-time-gpu", "vals": ["250"] },
      { "arg": "max-time-cpu", "vals": ["2000"] },
      { "arg": "deadline", "vals": ["900"] }
    ]
  },
  "validations": {
    "clpeak_tests": {
      "description": "comma-separated clpeak categories or tests, or all",
      "args": ["tests"],
      "vals": "^(all|([a-z0-9-]+)(,[a-z0-9-]+)*)$"
    },
    "clpeak_devices": {
      "description": "optional comma-separated backend:index device selector",
      "args": ["devices"],
      "vals": "^$|^[a-z0-9]+:[0-9]+(,[a-z0-9]+:[0-9]+)*$"
    },
    "clpeak_gpu_budget": {
      "description": "GPU calibration budget from 10 through 60000 milliseconds",
      "args": ["max-time-gpu"],
      "vals": "^([1-9][0-9]|[1-5][0-9]{2}|[1-5][0-9]{3}|60000)$"
    },
    "clpeak_cpu_budget": {
      "description": "CPU test budget from 10 through 60000 milliseconds",
      "args": ["max-time-cpu"],
      "vals": "^([1-9][0-9]|[1-5][0-9]{2}|[1-5][0-9]{3}|60000)$"
    },
    "clpeak_deadline": {
      "description": "wrapper watchdog from 30 through 86400 seconds",
      "args": ["deadline"],
      "vals": "^([3-9][0-9]|[1-9][0-9]{2}|[1-9][0-9]{3}|[1-8][0-9]{3}|86400)$"
    }
  }
}

